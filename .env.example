# Copy to .env.local for local development. Never commit real values.

# Neon Postgres (set automatically when Neon is connected through the Vercel Marketplace)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (Dashboard > R2 > Manage API tokens, Object Read & Write scoped to the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dental-portal-files

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional on Vercel (derived from the deployment URL); set for local development.
BETTER_AUTH_URL=http://localhost:3000

# Demo mode: emails are stored and shown at /demo-inbox instead of being sent,
# and demo logins are listed on the sign-in pages. Never enable with real users.
DEMO_MODE=true

# Email delivery (optional). Without these, emails stay in the outbox.
RESEND_API_KEY=
EMAIL_FROM="Dental Design Portal <cases@your-domain.com>"
